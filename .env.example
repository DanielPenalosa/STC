# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only; used by edge functions

# Logo (optional) — drop the [LOGO] placeholder once the client provides one
NEXT_PUBLIC_LOGO_URL=

# AI vision — the default pipeline is 100% FREE and fully LOCAL
# (CLIP zero-shot via Transformers.js, runs inside the Next.js server).
# No API key is needed. The model (~150MB, Apache-2.0 license) auto-downloads
# on first use and is cached in .transformers-cache — override the location:
# TRANSFORMERS_CACHE=./.transformers-cache
#
# The legacy paid-provider vars below are no longer used by the main pipeline
# (kept only for the optional Supabase Edge Function path):
# AI_VISION_PROVIDER=openai|custom
# OPENAI_API_KEY=sk-...
# AI_VISION_ENDPOINT=https://...
# AI_VISION_API_KEY=...

# Optional: Cloudinary for report-photo storage (falls back to Supabase Storage when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: auto-post resolved reports (before/after photos) to a Facebook Page.
# Needs a PAGE access token with pages_manage_posts + pages_read_engagement
# (long-lived page tokens don't expire). NEXT_PUBLIC_APP_ORIGIN is the public
# site URL Facebook uses to fetch the photos (Vercel's VERCEL_URL works too).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
NEXT_PUBLIC_APP_ORIGIN=
